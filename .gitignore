node_modules/
.nuxt/
.output/
.data/

# Secrets. `.env` alone does NOT match .env.bak or .env.local — a bare `.env` rule
# is a common way to leak a key in a backup file. `.env.example` is the tracked
# template and must survive, hence the negation.
.env
.env.*
!.env.example

*.bin
dist/

# Arduino build trees — about 60 MB of .o files and archives per sketch.
firmware/*/build/

# Generated by scripts/build.mjs from firmware/pin_config.h, which IS tracked.
# Editing one of these is a mistake; it gets overwritten on the next build.
firmware/*/pin_config.h

# WiFi credentials and the device token. secrets.h.example is the tracked template.
firmware/*/secrets.h

# Watch faces: the SOURCE photo in faces/ is tracked (nothing here excludes it), the
# 322 KB RGB565 blob and its preview are build outputs of scripts/face.py and are not.
# Same rule as pin_config.h — one source of truth, generated copies stay out.
# ORDER MATTERS: if you ever add `!firmware/*.bin` to track the partition table and
# its readback, put it ABOVE these two lines or it will drag the faces back in.
firmware/face*.bin
firmware/face*.png

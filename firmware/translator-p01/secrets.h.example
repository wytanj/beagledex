#pragma once
/*
 * Copy to secrets.h and fill in. Optional — without it the sketch runs in
 * offline mode and logs to serial only. Audio works either way.
 *
 * secrets.h is gitignored. Note that anything compiled in here is recoverable
 * from the flash image with esptool + strings, so WiFi credentials for a
 * throwaway dev network are fine and nothing else belongs here. Real per-device
 * credentials go in NVS, and provider API keys never leave the backend.
 */

#define WIFI_SSID     "your-network"
#define WIFI_PASS     "your-password"

/* Your machine's LAN IP while running `npm run dev` — not localhost, which
 * from the board's point of view is the board. */
#define CONSOLE_URL   "http://192.168.0.250:3000"

/* Must match DEVICE_TOKEN in the console's .env */
#define DEVICE_TOKEN  "dev-only-change-me"

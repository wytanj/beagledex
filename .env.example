# Copy to .env and fill in. .env is gitignored; this template is tracked.

# Shared secret the firmware sends as `Authorization: Bearer <token>`.
# If unset, device-facing routes run UNAUTHENTICATED and log a warning —
# fine on localhost, never once the device is on a network.
# Generate one with:  python -c "import secrets;print(secrets.token_hex(24))"
DEVICE_TOKEN=dev-only-change-me

# xAI key for the translate pipeline (STT + chat + TTS). Lives here and ONLY here —
# never compiled into firmware, which is trivially dumpable over USB.
XAI_API_KEY=

# Optional second provider for translation (Translate app: tap the status band to
# switch grok<->gemini for real-world latency comparison). Gemini takes audio
# natively, so it's one call instead of xAI's STT+chat. TTS stays on xAI either way.
GEMINI_API_KEY=

# Optional tuning:
#   XAI_CHAT_MODEL  translation model (default grok-4.20-0309-non-reasoning)
#   GEMINI_MODEL    gemini model      (default gemini-2.5-flash-lite)
#   TTS_PEAK        spoken-reply loudness, 0..1 peak target (default 0.6 ≈ -4.6 dBFS)
# XAI_CHAT_MODEL=grok-4.20-0309-non-reasoning
# GEMINI_MODEL=gemini-2.5-flash-lite
# TTS_PEAK=0.6

# WiFi networks pushed to the device over serial (npm run push wifi / hotspot).
# Several can be stored; the device joins whichever is in range. The ESP32-S3 is
# 2.4 GHz only — a phone hotspot must offer a 2.4 GHz band (iPhone: "Maximize
# Compatibility" on).
HOME_WIFI_SSID=
HOME_WIFI_PASSWORD=
PHONE_WIFI_SSID=
PHONE_WIFI_PASSWORD=
